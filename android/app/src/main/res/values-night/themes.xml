<?xml version="1.0" encoding="utf-8"?>
<!--
    Night variant. Android picks this automatically when the phone is in dark mode,
    matching what PlantGuardTheme does in Kotlin via isSystemInDarkTheme(), so the
    launch window and the app agree in both modes.
-->
<resources>
    <style name="Theme.PlantGuard" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

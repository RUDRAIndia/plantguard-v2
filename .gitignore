# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter / Colab
.ipynb_checkpoints/

# Artifacts: trained models, figures, metrics JSONs are large / regenerable
artifacts/*
!artifacts/**/.gitkeep

# Raw and processed datasets are not checked into git (root-level only —
# does not match src/data, which holds pipeline code, not data)
/data/
*.zip
*.tar.gz

# Model weights / exported models — must never be committed regardless of
# where they end up (artifacts/ is already fully ignored above; these
# patterns catch stray exports elsewhere, e.g. colab/ or repo root)
*.h5
*.hdf5
*.keras
*.tflite
# Exception: the Android app's bundled placeholder/real model asset is a
# real, intentionally committed artifact (see android/README.md) — without
# it the app can't build in a fresh clone or CI.
!android/app/src/main/assets/model.tflite
*.pb
*.ckpt
*.ckpt.*
checkpoint

# Secrets — API keys, env files, Kaggle credentials
.env
.env.*
kaggle.json
.kaggle/

# Android build outputs
android/**/build/
android/**/.gradle/
android/local.properties
*.apk
*.aab

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
